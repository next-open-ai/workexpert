{
  "name": "@next-open-ai/workexpert",
  "version": "0.4.30",
  "private": false,
  "description": "WorkExpert — cross-platform local AI expert workspace.",
  "packageManager": "pnpm@10.20.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "workexpert": "./bin/workexpert.mjs"
  },
  "files": [
    "bin",
    "apps/api/dist",
    "apps/renderer/dist",
    "scripts/start-web.mjs",
    "scripts/lib",
    "runtimes/agentscope-runtime/src/**/*.py",
    "runtimes/agentscope-runtime/requirements.txt",
    "runtimes/agentscope-runtime/pyproject.toml",
    "README.md",
    "README-EN.md",
    "docs",
    "apps/gateway/package.json",
    "apps/gateway/dist/**/*.js",
    "apps/gateway/dist/**/*.d.ts",
    "packages/channel/package.json",
    "packages/channel/dist/*.js",
    "packages/channel/dist/*.d.ts"
  ],
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.1",
    "@lancedb/lancedb": "0.22.3",
    "@larksuiteoapi/node-sdk": "^1.11.1",
    "@workexpert/channel": "file:./packages/channel",
    "apache-arrow": "18.1.0",
    "fastify": "^5.3.0",
    "fflate": "^0.8.3",
    "sql.js": "^1.14.2",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "pnpm --filter @workexpert/desktop dev",
    "web:build": "pnpm build",
    "web:start": "node scripts/start-web.mjs",
    "workexpert:start": "node bin/workexpert.mjs start",
    "workexpert:init": "node bin/workexpert.mjs init",
    "workexpert:doctor": "node bin/workexpert.mjs doctor",
    "build": "pnpm --filter @workexpert/contracts build && pnpm --filter @workexpert/tools build && pnpm --filter @workexpert/storage build && pnpm --filter @workexpert/channel build && pnpm --filter @workexpert/gateway build && pnpm --filter @workexpert/agent-core build && pnpm --filter @workexpert/orchestrator build && pnpm --filter @workexpert/api build && pnpm --filter @workexpert/renderer build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "tasks:smoke": "node scripts/template-tasks-smoke.mjs",
    "lint": "pnpm -r --if-present lint",
    "package": "pnpm --filter @workexpert/desktop package",
    "size:check": "node scripts/check-size.mjs",
    "orch:smoke": "node scripts/run-with-smoke-api.mjs scripts/headless-gateway-smoke.mjs memory-approval",
    "orch:remote-confirm": "node scripts/remote-project-confirm.mjs",
    "orch:remote-chat": "node scripts/remote-chat.mjs",
    "chat-attachments:regression": "pnpm --filter @workexpert/agent-core build && pnpm --filter @workexpert/orchestrator build && pnpm --filter @workexpert/api build && node scripts/chat-attachments-regression.mjs",
    "voice:command:regression": "node scripts/voice-command-regression.mjs",
    "product:regression": "node scripts/workexpert-product-regression.mjs",
    "ui:core:regression": "node scripts/core-ui-browser-regression.mjs",
    "npm:package:regression": "node scripts/npm-package-regression.mjs",
    "durable-task:regression": "node scripts/durable-task-regression.mjs",
    "gateway:stub": "node scripts/run-with-smoke-api.mjs scripts/gateway-stub-smoke.mjs",
    "gateway:config": "node scripts/gateway-config.mjs",
    "gateway:feishu": "node scripts/run-with-smoke-api.mjs scripts/gateway-feishu-smoke.mjs",
    "gateway:relay": "node scripts/run-with-smoke-api.mjs scripts/relay-smoke.mjs",
    "agentscope:smoke": "node scripts/agentscope-smoke.mjs",
    "dsh:regression": "node scripts/dsh-mcp-skills-regression.mjs",
    "esight:contracts:regression": "pnpm --filter @workexpert/contracts build && node scripts/esight-contracts-regression.mjs",
    "mcp:user-scope:regression": "node scripts/mcp-user-scope-regression.mjs",
    "manual:generate": "node scripts/generate-user-manual.mjs",
    "manual:images": "node scripts/optimize-user-manual-images.mjs",
    "manual:regression": "pnpm --filter @workexpert/renderer build && node scripts/user-manual-regression.mjs",
    "concurrency:loadtest": "node scripts/concurrency-loadtest.mjs",
    "concurrency:regression": "node scripts/concurrency-regression.mjs",
    "owner:migrate:check": "node scripts/migrate-owner-fields.mjs",
    "owner:migrate": "node scripts/migrate-owner-fields.mjs --write"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.8.3",
    "vitepress": "2.0.0-alpha.20",
    "ws": "^8.18.0"
  }
}
